# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 运行产物（排料结果 intermediate / SVG / PNG / 曲线）
out/

# 虚拟环境
.venv/
venv/

# Node（前端依赖，本地装）
node_modules/

# 前端构建产物（npm run build 输出；由 materialSorting-web/src/ 编译生成，不入库）
materialSorting-web/static/

# Ralph 自动循环产物（运行时生成，勿入库）
.all_done
.last-branch
archive/

# 后端启动日志（本地重定向产物，勿入库）
.backend.log

# tsc -b 手跑误 emit 产物（官方 build = tsc --noEmit；vite.config.js 会被 Vite 优先解析，残留即配置漂移隐患）
materialSorting-web/*.tsbuildinfo
materialSorting-web/vite.config.js
materialSorting-web/vite.config.d.ts

# 冒烟脚本截图产物（scripts/shot-*.png，按需再生成）
materialSorting-web/scripts/shot-*.png
